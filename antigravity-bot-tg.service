[Unit]
Description=Telegravity - Antigravity CLI Telegram Bot Service
After=network.target

[Service]
Type=simple
User=<YOUR_USERNAME>
# Note: Update WorkingDirectory and ExecStart to match your installation directory
WorkingDirectory=/path/to/your/projects/agy-telegram-bot
ExecStart=/path/to/your/projects/agy-telegram-bot/antigravity-bot
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=agy-telegram-bot
# Set PATH explicitly if 'agy' command is not found. Replace <YOUR_USERNAME> accordingly.
Environment="PATH=/usr/local/bin:/usr/bin:/bin:/home/<YOUR_USERNAME>/.local/bin:/home/<YOUR_USERNAME>/go/bin"

[Install]
WantedBy=multi-user.target

