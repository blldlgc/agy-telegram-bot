# Bắt buộc: Dán Token Telegram Bot mà bạn lấy từ BotFather (@BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# ---------------- QUYỀN TRUY CẬP (WHITELIST) ----------------
# Nếu bỏ trống, bot sẽ mặc định phục vụ ở tất cả các nơi nó tham gia

# Giới hạn người dùng (User IDs)
# Để lấy User ID của bạn, hãy chat với bot @userinfobot trên Telegram
ALLOWED_USER_IDS=123456789,987654321

# Giới hạn Group/Chat (Chat IDs)
# Nếu bạn add bot vào một group chat, ID của group thường bắt đầu bằng dấu trừ (-).
# Ví dụ: -1001234567890 là id của nhóm "My Private Group" có link https://web.telegram.org/k/#-1234567890 khi mở Telegram từ giao diện web
ALLOWED_CHAT_IDS=

# ---------------- CẤU HÌNH SANDBOX & AGENT ----------------
ANTIGRAVITY_CMD=agy

# Sandbox Dirs: Các thư mục an toàn trên máy chủ mà Bot được phép thao tác.
# RẤT QUAN TRỌNG: Bot sẽ KHÔNG THỂ thoát ra khỏi các thư mục này.
ALLOWED_DIRS=/path/to/your/projects,/var/www/html