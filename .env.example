# Required: Paste the Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# ---------------- ACCESS CONTROL (WHITELIST) ----------------
# If left empty, the bot will serve all chats by default (not recommended)

# Allowed User IDs (comma-separated)
# To find your User ID, message @userinfobot on Telegram
ALLOWED_USER_IDS=123456789,987654321

# Allowed Group/Chat IDs (comma-separated)
# Group Chat IDs usually start with a minus sign (e.g. -1001234567890)
ALLOWED_CHAT_IDS=

# ---------------- SANDBOX & AGENT CONFIGURATION ----------------
ANTIGRAVITY_CMD=agy

# Sandbox Directories: Safe server directories that the bot is allowed to access and modify.
# IMPORTANT: The bot will NOT be able to navigate outside these directories.
ALLOWED_DIRS=/path/to/your/projects,/var/www/html
